{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // wxt 0.21 activo "noUncheckedIndexedAccess" en el tsconfig que genera.
    // El codigo nunca se escribio con esa regla: prenderla deja 108 errores
    // de tipos preexistentes en 19 archivos (medido con
    // "npx tsc --noEmit --noUncheckedIndexedAccess" el 09/09/2026), ninguno
    // introducido por la 0.8.1. Es un trabajo aparte, no algo para meter en
    // una version que va a revision de la Store. Se mantiene el nivel de
    // chequeo que tenia el proyecto con wxt 0.20.
    "noUncheckedIndexedAccess": false,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@modules/*": ["./modules/*"]
    },
    "types": ["chrome"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "modules/**/*.ts"
  ]
}
